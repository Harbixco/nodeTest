<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-green-900 min-h-screen flex items-center justify-center">
    <div
      class="bg-green-950 bg-opacity-70 backdrop-blur-md text-white p-8 rounded-2xl shadow-lg w-80"
    >
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold">Sign up Page!</h2>
      </div>

      <form class="space-y-4" action="/signup" method="POST">
        <div>
          <label for="name" class="block text-sm mb-1">Username</label>
          <input
            type="text"
            id="name"
            placeholder="Enter your username"
            name="username"
            class="w-full px-4 py-2 bg-transparent border border-green-500 rounded-md text-sm text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500"
          />
        </div>

        <div>
          <label for="email" class="block text-sm mb-1">E-mail</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="example@email.com"
            class="w-full px-4 py-2 bg-transparent border border-green-500 rounded-md text-sm text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500"
          />
        </div>

        <div>
          <label for="password" class="block text-sm mb-1">Password</label>
          <div class="relative">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="************"
              class="w-full px-4 py-2 bg-transparent border border-green-500 rounded-md text-sm text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500"
            />
            <span class="absolute right-3 top-2.5 cursor-pointer text-gray-400">
              👁️
            </span>
          </div>
        </div>

        <div class="text-right text-sm text-gray-400">
          <a href="#" class="hover:underline">Forget password?</a>
        </div>

        <button
          type="submit"
          class="w-full bg-green-600 hover:bg-green-700 py-2 rounded-md font-semibold transition duration-300"
        >
          Login
        </button>
      </form>

      <p class="text-center text-sm text-gray-400 mt-6">
      Already have an account?
        <a href="/login" class="text-green-400 hover:underline">Login</a>
      </p>
    </div>
  </body>
</html>
