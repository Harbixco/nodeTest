<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Simple Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-green-900 min-h-screen flex text-white">
    <!-- Sidebar -->
    <aside class="w-64 bg-green-950 bg-opacity-70 flex flex-col p-6">
      <div class="mb-8">
        <h1 class="text-2xl font-bold">MyApp</h1>
      </div>
      <nav class="flex-1">
        <ul class="space-y-4">
          <li>
            <a href="#" class="flex items-center space-x-2 hover:text-green-300"
              ><span>🏠</span><span>Home</span></a
            >
          </li>
          <li>
            <a href="#" class="flex items-center space-x-2 hover:text-green-300"
              ><span>📊</span><span>Analytics</span></a
            >
          </li>
          <li>
            <a href="#" class="flex items-center space-x-2 hover:text-green-300"
              ><span>👥</span><span>Users</span></a
            >
          </li>
          <li>
            <a href="#" class="flex items-center space-x-2 hover:text-green-300"
              ><span>⚙️</span><span>Settings</span></a
            >
          </li>
        </ul>
      </nav>
      <div class="mt-auto">
        <button
          class="w-full bg-green-600 hover:bg-green-700 py-2 rounded-md font-semibold"
        >
          Logout
        </button>
      </div>
    </aside>

    <!-- Main content -->
    <div class="flex-1 flex flex-col">
      <!-- Top bar -->
      <header
        class="flex items-center justify-between bg-green-950 bg-opacity-50 px-6 py-4"
      >
        <h2 class="text-xl font-semibold">Dashboard</h2>
        <div class="flex items-center space-x-4">
          <input
            type="text"
            placeholder="Search..."
            class="px-3 py-1 bg-transparent border border-green-500 rounded-md placeholder-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-green-500"
          />
          <div
            class="w-8 h-8 bg-green-800 bg-opacity-60 rounded-full flex items-center justify-center cursor-pointer"
          >
            <span>A</span>
          </div>
        </div>
      </header>

      <!-- Dashboard cards -->
      <main class="p-6 overflow-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-green-800 bg-opacity-50 p-5 rounded-lg shadow">
            <h3 class="text-lg font-medium mb-2">Total Users</h3>
            <p class="text-3xl font-bold">1,234</p>
          </div>

          <div class="bg-green-800 bg-opacity-50 p-5 rounded-lg shadow">
            <h3 class="text-lg font-medium mb-2">Active Sessions</h3>
            <p class="text-3xl font-bold">87</p>
          </div>

          <div class="bg-green-800 bg-opacity-50 p-5 rounded-lg shadow">
            <h3 class="text-lg font-medium mb-2">Revenue</h3>
            <p class="text-3xl font-bold">$4,560</p>
          </div>

          <div class="bg-green-800 bg-opacity-50 p-5 rounded-lg shadow">
            <h3 class="text-lg font-medium mb-2">New Sign‑ups</h3>
            <p class="text-3xl font-bold">56</p>
          </div>

          <div class="bg-green-800 bg-opacity-50 p-5 rounded-lg shadow">
            <h3 class="text-lg font-medium mb-2">Server Uptime</h3>
            <p class="text-3xl font-bold">99.9%</p>
          </div>

          <div class="bg-green-800 bg-opacity-50 p-5 rounded-lg shadow">
            <h3 class="text-lg font-medium mb-2">Support Tickets</h3>
            <p class="text-3xl font-bold">12</p>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
