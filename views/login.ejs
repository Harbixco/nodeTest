<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login UI</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen flex items-center justify-center bg-green-900">
    <div
      class="bg-green-950 bg-opacity-70 backdrop-blur-md p-8 rounded-2xl shadow-lg w-80 text-white"
    >
      <div class="text-center mb-6">
        <h2 class="text-xl font-bold">Login Page!</h2>
      </div>

      <form class="space-y-4" action="/login" method="POST">
        <div>
          <label class="block text-sm mb-1" for="email">Username</label>
          <input
            type="text"
            name="username"
            id="username"
            placeholder="Enter your username"
            class="w-full px-4 py-2 bg-transparent border border-green-500 rounded-md text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500"
          />
        </div>

        <div>
          <label class="block text-sm mb-1" for="password">Password</label>
          <div class="relative">
            <input
              type="password"
              name="password"
              id="password"
              placeholder="************"
              class="w-full px-4 py-2 bg-transparent border border-green-500 rounded-md text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500"
            />
            <span class="absolute right-3 top-2.5 cursor-pointer text-gray-400">
              👁️
            </span>
          </div>
        </div>

        <div class="text-right text-sm text-gray-400">
          <a href="#" class="hover:underline">Forget password?</a>
        </div>

        <button
          type="submit"
          class="w-full bg-green-600 hover:bg-green-700 py-2 rounded-md font-semibold transition duration-300"
        >
          Login
        </button>
      </form>

      <p class="text-center text-sm text-gray-400 mt-6">
        Don’t have an account?
        <a href="/signup" class="text-green-400 hover:underline">Sign up</a>
      </p>
    </div>
  </body>
</html>
